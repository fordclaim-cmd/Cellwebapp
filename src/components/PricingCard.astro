---
import { PRICING, BOOKING_URL } from '../config';

// Hormozi value stack: anchor each deliverable's standalone value, sum it,
// then reveal the real price. Numbers are honest local-market equivalents.
const stack = [
  ['A website built to book jobs, not just sit there', '$4,500'],
  ['Local SEO + Google Business Profile, managed every month', '$1,200/mo'],
  ['Review engine that grows your star rating on autopilot', '$500/mo'],
  ['Lead capture + fast follow-up so no call slips', '$800'],
  ['Monthly marketing + a plain-English report', '$1,000/mo'],
];
---
<div class="mx-auto max-w-xl overflow-hidden rounded-3xl border border-ink/10 bg-white shadow-2xl shadow-ink/10">
  <div class="bg-deep px-8 py-6 text-center text-white">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold">The Goliath Growth System</p>
    <p class="mt-1 text-white/70">Everything below, run for you — one system, one price.</p>
  </div>

  <div class="px-8 pt-8">
    <ul class="space-y-3 text-sm">
      {stack.map(([item, value]) => (
        <li class="flex items-start justify-between gap-4 border-b border-ink/5 pb-3">
          <span class="flex gap-2"><span class="text-accent">✓</span>{item}</span>
          <span class="shrink-0 text-ink/40 line-through">{value}</span>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex items-baseline justify-between">
      <span class="font-semibold text-ink/60">Real-world value</span>
      <span class="text-xl font-bold text-ink/40 line-through">$6,100+ up front, $2,700/mo</span>
    </div>

    <div class="mt-6 rounded-2xl bg-paper p-6 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">You pay</p>
      <div class="mt-2 flex items-end justify-center gap-2">
        <span class="text-5xl font-bold">${PRICING.setup.toLocaleString()}</span>
        <span class="pb-1 text-ink/60">to build</span>
        <span class="px-2 pb-1 text-2xl text-ink/30">+</span>
        <span class="text-5xl font-bold">${PRICING.monthly}</span>
        <span class="pb-1 text-ink/60">/mo</span>
      </div>
      <p class="mt-2 text-sm text-ink/60">Less than one lost job a month.</p>
    </div>

    <a href={BOOKING_URL} class="mt-6 block rounded-full bg-accent py-4 text-center text-lg font-semibold text-white transition hover:bg-accent/90">
      Claim your free game plan →
    </a>
  </div>

  <div class="mt-6 flex items-center gap-3 bg-gold/10 px-8 py-4 text-sm">
    <span class="text-2xl">🛡️</span>
    <p><span class="font-bold">90-Day Ring Guarantee:</span> if your phone isn't ringing with new leads in 90 days, we work free until it does.</p>
  </div>

  <p class="px-8 pb-8 pt-4 text-center text-xs text-ink/50">Month to month. No long contracts. You own everything. Cancel anytime.</p>
</div>
