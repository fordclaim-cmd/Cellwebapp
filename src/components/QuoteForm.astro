---
// Two-step quote form (service picker → details). Only name + phone gate the
// submission; everything else is optional enrichment on the same request.
// Vanilla TS — one client script, no framework runtime. Honeypot: _hp.
import Icon from './Icon.astro';
const services = [
  ['globe', 'New Website'],
  ['search', 'Local SEO'],
  ['pin', 'Google Business Profile'],
  ['star', 'Reviews & Reputation'],
  ['target', 'Local Service Ads'],
  ['dollar', 'Paid Ads & Social'],
  ['bolt', 'Automation & AI'],
  ['phone', 'Not sure — help me'],
] as const;
const input = 'mt-1 h-11 w-full rounded-lg border border-line bg-paper px-3.5 text-base text-navy placeholder:text-mute/60 focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20';
---
<div id="quote" class="scroll-mt-24 overflow-hidden rounded-[24px] border border-line bg-paper shadow-xl shadow-navy/10">
  <div class="h-1.5 w-full" style="background: linear-gradient(90deg, #1196cc 0%, #f6bb06 100%)"></div>
  <div class="p-6 sm:p-8">
  <form id="quote-form" class="space-y-4" novalidate>
    <!-- progress bar -->
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-line">
      <div data-progress class="h-full rounded-full transition-[width] duration-300" style="width:12%; background: linear-gradient(90deg, #1196cc 0%, #f6bb06 100%)"></div>
    </div>

    <!-- honeypot -->
    <input name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] opacity-0" />
    <input type="hidden" name="service" value="" />

    <!-- STEP 1: service picker -->
    <div data-step="service">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-navy">What do you need? <span class="font-medium tracking-normal text-mute">(pick one)</span></p>
      <div class="mt-3 grid grid-cols-2 gap-2.5" role="group" aria-label="What do you need">
        {services.map(([icon, label]) => (
          <button type="button" data-service={label} class="flex min-h-[88px] flex-col items-center justify-center gap-2 rounded-lg border border-line bg-mist px-2 py-3 text-center text-sm font-semibold leading-tight text-navy transition hover:border-cyan hover:bg-cyan/5 focus:outline-none focus:ring-2 focus:ring-cyan/20">
            <Icon name={icon} size={26} class="text-cyan" />
            {label}
          </button>
        ))}
      </div>
    </div>

    <!-- STEP 2: details (hidden until a service is chosen) -->
    <div data-step="details" class="hidden space-y-4">
      <div class="flex items-center justify-between gap-2 rounded-lg border border-cyan/25 bg-cyan/10 px-3.5 py-2 text-sm">
        <span data-chosen class="truncate font-semibold text-navy"></span>
        <button type="button" data-change class="shrink-0 text-xs font-bold uppercase tracking-wide text-cyan-deep underline underline-offset-2">Change</button>
      </div>

      <label class="block text-sm font-semibold text-navy">Name *
        <input name="name" required autocomplete="name" maxlength="100" class={input} />
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm font-semibold text-navy">Phone *
          <input name="phone" type="tel" inputmode="tel" required autocomplete="tel" maxlength="25" class={input} />
        </label>
        <label class="block text-sm font-semibold text-navy">City <span class="font-normal text-mute">(optional)</span>
          <input name="city" autocomplete="address-level2" maxlength="100" class={input} />
        </label>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm font-semibold text-navy">Business name <span class="font-normal text-mute">(optional)</span>
          <input name="businessName" autocomplete="organization" maxlength="100" class={input} />
        </label>
        <label class="block text-sm font-semibold text-navy">Email <span class="font-normal text-mute">(optional)</span>
          <input name="email" type="email" inputmode="email" autocomplete="email" maxlength="200" class={input} />
        </label>
      </div>
      <label class="block text-sm font-semibold text-navy">Current website <span class="font-normal text-mute">(optional)</span>
        <input name="currentWebsite" inputmode="url" maxlength="200" placeholder="yourbusiness.com" class={input} />
      </label>
      <label class="block text-sm font-semibold text-navy">Anything we should know? <span class="font-normal text-mute">(optional)</span>
        <textarea name="message" maxlength="2000" rows="2" class="mt-1 w-full resize-none rounded-lg border border-line bg-paper px-3.5 py-2 text-base text-navy placeholder:text-mute/60 focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20"></textarea>
      </label>

      <label class="flex items-start gap-2.5 text-xs leading-snug text-mute">
        <input type="checkbox" name="marketing_consent" class="mt-0.5 size-5 shrink-0 accent-cyan" />
        <span>Also send me tips, offers, and updates from Goliath Solutions by text and email. Not required to get a quote — reply STOP to opt out anytime.</span>
      </label>

      <p data-status role="alert" class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"></p>

      <button type="submit" class="flex h-12 w-full items-center justify-center gap-2 rounded-full bg-gold text-lg font-bold text-navy transition hover:bg-gold-deep hover:text-white disabled:opacity-70">
        Get my free game plan <Icon name="arrow" size={18} />
      </button>
      <p class="text-center text-xs text-mute">Takes 20 seconds. We call you back within one business day.</p>
      <p class="text-center text-[11px] leading-snug text-mute/80">
        By submitting, you agree Goliath Solutions may contact you about your request by phone, text, and email. Msg &amp; data rates may apply; reply STOP to opt out of texts anytime.
      </p>
    </div>
  </form>

  <!-- success state (swapped in on submit) -->
  <div data-success class="hidden py-6 text-center">
    <div class="mx-auto grid size-14 place-items-center rounded-full bg-cyan text-white"><Icon name="check" size={28} /></div>
    <h3 class="mt-4 text-xl font-black text-navy">Got it — we'll call you.</h3>
    <p class="mt-2 text-mute">Within one business day, from the operator — not a chatbot. Talk soon.</p>
  </div>
  </div>
</div>

<script>
  const root = document.getElementById('quote') as HTMLElement;
  const form = root.querySelector('#quote-form') as HTMLFormElement;
  const serviceInput = form.querySelector('input[name="service"]') as HTMLInputElement;
  const stepService = form.querySelector('[data-step="service"]') as HTMLElement;
  const stepDetails = form.querySelector('[data-step="details"]') as HTMLElement;
  const chosen = form.querySelector('[data-chosen]') as HTMLElement;
  const bar = form.querySelector('[data-progress]') as HTMLElement;
  const status = form.querySelector('[data-status]') as HTMLElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const success = root.querySelector('[data-success]') as HTMLElement;

  // Progress: service card (1) + the 6 detail fields that carry a value.
  const progressFields = ['name', 'phone', 'city', 'businessName', 'email', 'currentWebsite'];
  function updateProgress() {
    let filled = serviceInput.value ? 1 : 0;
    for (const n of progressFields) {
      const el = form.elements.namedItem(n) as HTMLInputElement | null;
      if (el && el.value.trim()) filled++;
    }
    bar.style.width = `${Math.min(100, 12 + (88 * filled) / (progressFields.length + 1))}%`;
  }

  function chooseService(label: string) {
    serviceInput.value = label;
    chosen.textContent = label;
    stepService.classList.add('hidden');
    stepDetails.classList.remove('hidden');
    updateProgress();
    (form.elements.namedItem('name') as HTMLInputElement | null)?.focus();
  }

  root.querySelectorAll('[data-service]').forEach((btn) =>
    btn.addEventListener('click', () => chooseService((btn as HTMLElement).dataset.service || 'General')),
  );
  form.querySelector('[data-change]')?.addEventListener('click', () => {
    stepDetails.classList.add('hidden');
    stepService.classList.remove('hidden');
  });
  form.addEventListener('input', updateProgress);

  // Client-side NANP phone check, mirrors the server so users don't get a
  // surprise error after submit.
  function validPhone(raw: string): boolean {
    const d = raw.replace(/\D/g, '');
    const e164 = d.length === 10 ? `1${d}` : d.length === 11 && d.startsWith('1') ? d : '';
    return /^1[2-9]\d{2}[2-9]\d{6}$/.test(e164);
  }

  function showError(msg: string) {
    status.textContent = msg;
    status.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.classList.add('hidden');
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.name || data.name.trim().length < 2) return showError('Please enter your name.');
    if (!validPhone(data.phone || '')) return showError('Please enter a valid US phone number.');
    if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) return showError('That email looks off — check it or leave it blank.');

    button.disabled = true;
    button.textContent = 'Sending…';
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: ctrl.signal,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.add('hidden');
      success.classList.remove('hidden');
    } catch {
      showError('Something went wrong — call or email us and we’ll sort it out.');
      button.disabled = false;
      button.textContent = 'Get my free game plan →';
    } finally {
      clearTimeout(timer);
    }
  });
</script>
