---
// Two-step quote form (service picker → details). Only name + phone gate the
// submission; everything else is optional enrichment on the same request.
// Vanilla TS — one client script, no framework runtime. Honeypot: _hp.
const services = [
  ['🌐', 'New Website'],
  ['🔍', 'Local SEO'],
  ['📍', 'Google Business Profile'],
  ['⭐', 'Reviews & Reputation'],
  ['⚡', 'Automation & AI'],
  ['🧭', 'Not sure — help me'],
];
const input = 'mt-1 h-11 w-full rounded-lg border border-ink/20 bg-white px-3.5 text-base focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';
---
<div id="quote" class="scroll-mt-24 rounded-3xl border border-ink/10 bg-white p-6 shadow-xl shadow-ink/5 sm:p-8">
  <form id="quote-form" class="space-y-4" novalidate>
    <!-- progress bar -->
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-ink/10">
      <div data-progress class="h-full rounded-full bg-accent transition-[width] duration-300" style="width:12%"></div>
    </div>

    <!-- honeypot -->
    <input name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] opacity-0" />
    <input type="hidden" name="service" value="" />

    <!-- STEP 1: service picker -->
    <div data-step="service">
      <p class="text-sm font-bold uppercase tracking-wide text-ink">What do you need? <span class="font-medium normal-case tracking-normal text-ink/50">(pick one)</span></p>
      <div class="mt-3 grid grid-cols-2 gap-2.5" role="group" aria-label="What do you need">
        {services.map(([icon, label]) => (
          <button type="button" data-service={label} class="flex min-h-[84px] flex-col items-center justify-center gap-1.5 rounded-lg border border-ink/15 bg-white px-2 py-3 text-center text-sm font-semibold leading-tight transition hover:border-accent hover:bg-accent/5 focus:outline-none focus:ring-2 focus:ring-accent/20">
            <span class="text-2xl">{icon}</span>
            {label}
          </button>
        ))}
      </div>
    </div>

    <!-- STEP 2: details (hidden until a service is chosen) -->
    <div data-step="details" class="hidden space-y-4">
      <div class="flex items-center justify-between gap-2 rounded-lg bg-accent/5 px-3.5 py-2 text-sm">
        <span data-chosen class="truncate font-semibold text-ink"></span>
        <button type="button" data-change class="shrink-0 text-xs font-bold uppercase tracking-wide text-accent underline underline-offset-2">Change</button>
      </div>

      <label class="block text-sm font-semibold">Name *
        <input name="name" required autocomplete="name" maxlength="100" class={input} />
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm font-semibold">Phone *
          <input name="phone" type="tel" inputmode="tel" required autocomplete="tel" maxlength="25" class={input} />
        </label>
        <label class="block text-sm font-semibold">City <span class="font-normal text-ink/50">(optional)</span>
          <input name="city" autocomplete="address-level2" maxlength="100" class={input} />
        </label>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm font-semibold">Business name <span class="font-normal text-ink/50">(optional)</span>
          <input name="businessName" autocomplete="organization" maxlength="100" class={input} />
        </label>
        <label class="block text-sm font-semibold">Email <span class="font-normal text-ink/50">(optional)</span>
          <input name="email" type="email" inputmode="email" autocomplete="email" maxlength="200" class={input} />
        </label>
      </div>
      <label class="block text-sm font-semibold">Current website <span class="font-normal text-ink/50">(optional)</span>
        <input name="currentWebsite" inputmode="url" maxlength="200" placeholder="yourbusiness.com" class={input} />
      </label>
      <label class="block text-sm font-semibold">Anything we should know? <span class="font-normal text-ink/50">(optional)</span>
        <textarea name="message" maxlength="2000" rows="2" class="mt-1 w-full resize-none rounded-lg border border-ink/20 bg-white px-3.5 py-2 text-base focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"></textarea>
      </label>

      <label class="flex items-start gap-2.5 text-xs leading-snug text-ink/60">
        <input type="checkbox" name="marketing_consent" class="mt-0.5 size-5 shrink-0 accent-accent" />
        <span>Also send me tips, offers, and updates from Goliath Solutions by text and email. Not required to get a quote — reply STOP to opt out anytime.</span>
      </label>

      <p data-status role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>

      <button type="submit" class="h-12 w-full rounded-full bg-accent text-lg font-semibold text-white transition hover:bg-accent/90 disabled:opacity-70">
        Get my free game plan →
      </button>
      <p class="text-center text-xs text-ink/50">Takes 20 seconds. We call you back within one business day.</p>
      <p class="text-center text-[11px] leading-snug text-ink/40">
        By submitting, you agree Goliath Solutions may contact you about your request by phone, text, and email. Msg &amp; data rates may apply; reply STOP to opt out of texts anytime.
      </p>
    </div>
  </form>

  <!-- success state (swapped in on submit) -->
  <div data-success class="hidden py-6 text-center">
    <div class="text-4xl">✅</div>
    <h3 class="mt-3 text-xl font-bold">Got it — we'll call you.</h3>
    <p class="mt-2 text-ink/70">Within one business day, from the operator — not a chatbot. Talk soon.</p>
  </div>
</div>

<script>
  const root = document.getElementById('quote') as HTMLElement;
  const form = root.querySelector('#quote-form') as HTMLFormElement;
  const serviceInput = form.querySelector('input[name="service"]') as HTMLInputElement;
  const stepService = form.querySelector('[data-step="service"]') as HTMLElement;
  const stepDetails = form.querySelector('[data-step="details"]') as HTMLElement;
  const chosen = form.querySelector('[data-chosen]') as HTMLElement;
  const bar = form.querySelector('[data-progress]') as HTMLElement;
  const status = form.querySelector('[data-status]') as HTMLElement;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const success = root.querySelector('[data-success]') as HTMLElement;

  // Progress: service card (1) + the 6 detail fields that carry a value.
  const progressFields = ['name', 'phone', 'city', 'businessName', 'email', 'currentWebsite'];
  function updateProgress() {
    let filled = serviceInput.value ? 1 : 0;
    for (const n of progressFields) {
      const el = form.elements.namedItem(n) as HTMLInputElement | null;
      if (el && el.value.trim()) filled++;
    }
    bar.style.width = `${Math.min(100, 12 + (88 * filled) / (progressFields.length + 1))}%`;
  }

  function chooseService(label: string) {
    serviceInput.value = label;
    chosen.textContent = label;
    stepService.classList.add('hidden');
    stepDetails.classList.remove('hidden');
    updateProgress();
    (form.elements.namedItem('name') as HTMLInputElement | null)?.focus();
  }

  root.querySelectorAll('[data-service]').forEach((btn) =>
    btn.addEventListener('click', () => chooseService((btn as HTMLElement).dataset.service || 'General')),
  );
  form.querySelector('[data-change]')?.addEventListener('click', () => {
    stepDetails.classList.add('hidden');
    stepService.classList.remove('hidden');
  });
  form.addEventListener('input', updateProgress);

  // Client-side NANP phone check, mirrors the server so users don't get a
  // surprise error after submit.
  function validPhone(raw: string): boolean {
    const d = raw.replace(/\D/g, '');
    const e164 = d.length === 10 ? `1${d}` : d.length === 11 && d.startsWith('1') ? d : '';
    return /^1[2-9]\d{2}[2-9]\d{6}$/.test(e164);
  }

  function showError(msg: string) {
    status.textContent = msg;
    status.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.classList.add('hidden');
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (!data.name || data.name.trim().length < 2) return showError('Please enter your name.');
    if (!validPhone(data.phone || '')) return showError('Please enter a valid US phone number.');
    if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) return showError('That email looks off — check it or leave it blank.');

    button.disabled = true;
    button.textContent = 'Sending…';
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 8000);
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: ctrl.signal,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.classList.add('hidden');
      success.classList.remove('hidden');
    } catch {
      showError('Something went wrong — call or email us and we’ll sort it out.');
      button.disabled = false;
      button.textContent = 'Get my free game plan →';
    } finally {
      clearTimeout(timer);
    }
  });
</script>
