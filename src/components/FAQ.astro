---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="mx-auto max-w-[860px] space-y-3">
  {items.map((item) => (
    <details class="group overflow-hidden rounded-2xl border border-line transition open:bg-white/[0.02]">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-6 py-5 text-[16px] font-bold text-white">
        {item.q}
        <span class="shrink-0 text-xl leading-none text-flame transition-transform duration-200 group-open:rotate-45">+</span>
      </summary>
      <p class="px-6 pb-6 text-[14px] leading-relaxed text-ash">{item.a}</p>
    </details>
  ))}
</div>
