---
// Custom inline-SVG icon set — chunky (strokeWidth ~2.2), no library deps.
// Color comes from `currentColor` so each icon inherits the tile/text color.
// star + bolt are filled; everything else is stroked.
interface Props {
  name: 'globe' | 'search' | 'pin' | 'star' | 'phone' | 'chart' | 'bolt' | 'shield' | 'check' | 'arrow' | 'trophy' | 'target' | 'dollar' | 'clock';
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props;
const filled = name === 'star' || name === 'bolt';
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={cls}
>
  {name === 'globe' && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" /></>)}
  {name === 'search' && (<><circle cx="10.5" cy="10.5" r="6.5" /><path d="M20 20l-4.7-4.7" /></>)}
  {name === 'pin' && (<><path d="M12 22s7-6.3 7-12a7 7 0 0 0-14 0c0 5.7 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></>)}
  {name === 'star' && (<path d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17.9 6.1 20.8l1.3-6.5L2.5 9.8l6.6-.8L12 2.5Z" />)}
  {name === 'phone' && (<path d="M6 3h3l1.5 5-2 1.5a12 12 0 0 0 6 6l1.5-2 5 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z" />)}
  {name === 'chart' && (<><path d="M4 20V4M4 20h16" /><path d="M8 16v-4M12.5 16V8M17 16v-6" /></>)}
  {name === 'bolt' && (<path d="M13 2 4 13.5h6L11 22l9-11.5h-6L13 2Z" />)}
  {name === 'shield' && (<><path d="M12 22c5-2.2 8-6 8-11V5l-8-3-8 3v6c0 5 3 8.8 8 11Z" /><path d="M9 11.5l2.2 2.2L15.5 9.5" /></>)}
  {name === 'check' && (<path d="M5 12.5l4.5 4.5L19 7" stroke-width="3" />)}
  {name === 'arrow' && (<path d="M4 12h15M13 6l6 6-6 6" stroke-width="2.4" />)}
  {name === 'trophy' && (<><path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" /><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3M9 20h6M12 13v3M9.5 20h5" /></>)}
  {name === 'target' && (<><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none" /></>)}
  {name === 'dollar' && (<><path d="M12 3v18" /><path d="M16.5 7.5c-.7-1.6-2.4-2.5-4.5-2.5-2.5 0-4 1.3-4 3.2 0 4.6 8.5 2.4 8.5 7 0 2-1.8 3.3-4.5 3.3-2.3 0-4-1-4.7-2.6" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></>)}
</svg>
