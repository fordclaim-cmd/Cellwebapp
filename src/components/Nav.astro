---
import { BOOKING_URL } from '../config';
import Icon from './Icon.astro';
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-[1320px] items-center justify-between px-5 py-3.5">
    <a href="/" class="flex items-center gap-2.5">
      <span class="inline-grid size-9 place-items-center rounded-full bg-navy text-sm font-black text-white">G</span>
      <span class="text-[14px] font-bold uppercase tracking-[0.14em] text-navy">Goliath Solutions</span>
    </a>
    <nav class="hidden items-center gap-8 sm:flex">
      <a href="/#included" class="text-[13px] font-semibold uppercase tracking-[0.1em] text-mute transition hover:text-navy">The System</a>
      <a href="/#pricing" class="text-[13px] font-semibold uppercase tracking-[0.1em] text-mute transition hover:text-navy">Pricing</a>
      <a href="/work" class="text-[13px] font-semibold uppercase tracking-[0.1em] text-mute transition hover:text-navy">Work</a>
      <a href="/about" class="text-[13px] font-semibold uppercase tracking-[0.1em] text-mute transition hover:text-navy">About</a>
    </nav>
    <a href={BOOKING_URL} class="inline-flex items-center gap-2 rounded-full bg-gold px-5 py-2.5 text-[13px] font-bold uppercase tracking-[0.1em] text-navy transition hover:bg-gold-deep hover:text-white">
      Get my game plan <Icon name="arrow" size={15} />
    </a>
  </div>
</header>
