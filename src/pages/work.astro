---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { BOOKING_URL } from '../config';

import heroPool from '../assets/proof/hero-banner-pool.jpg';
import teamFull from '../assets/proof/team-full.jpg';
import techSkimming from '../assets/proof/tech-skimming-pool.jpg';
import techTesting from '../assets/proof/tech-water-testing.jpg';

const fbpStats = [
  ['#1196cc', '#1', '"best florida pools" on Google — up from #7'],
  ['#1196cc', '#2', '"pool heater maintenance" — 1,600 searches/mo'],
  ['#1196cc', 'Top 3', 'across Boca Raton & Delray Beach searches'],
  ['#a37c08', '★ 5.0', '200 Google reviews and climbing'],
];
---
<Layout
  title="Work — Goliath Solutions | We Rank Our Own Company"
  description="We don't have a testimonial wall — we have our own company ranked #1 on Google. See exactly how Goliath ranks Florida's Best Pools with the same system we build for the trades."
>
  <!-- HERO -->
  <section class="bg-navy px-5 py-20 text-center text-white sm:py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-gold">★ Proof, not promises</p>
      <h1 class="mx-auto mt-3 max-w-3xl font-black tracking-[-0.02em]" style="font-size: clamp(36px, 6vw, 64px)">We rank our own businesses. Then we do it for <span class="text-cyan">yours.</span></h1>
      <p class="mx-auto mt-4 max-w-xl text-white/75">Most agencies show you a portfolio of logos. We show you a company we're partners in — ranked #1, printing calls, on the exact system this site sells. Here are the receipts.</p>
    </div>
  </section>

  <!-- ===== FLAGSHIP: FLORIDA'S BEST POOLS ===== -->
  <section id="pools" class="mx-auto max-w-[1320px] px-5 py-20 sm:py-24">
    <div class="relative overflow-hidden rounded-[28px] shadow-xl shadow-navy/10">
      <Image src={heroPool} alt="A pristine South Florida pool serviced by Florida's Best Pools" class="h-64 w-full object-cover sm:h-80" />
      <span class="absolute left-5 top-5 rounded-full bg-gold px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-navy">★ Case File</span>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <span class="rounded-full bg-cyan/12 px-3 py-1 text-xs font-semibold text-cyan-deep">Home Services · Pool Care</span>
      <span class="rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-gold-deep">Our own company</span>
    </div>
    <h2 class="mt-4 font-black tracking-[-0.01em] text-navy" style="font-size: clamp(28px, 4.5vw, 42px)">Florida's Best Pools</h2>

    <div class="mt-6 grid gap-8 lg:grid-cols-2">
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-[0.16em] text-cyan">The problem</h3>
        <p class="mt-1.5 text-mute">A 40-year family operation. 10,000+ pools serviced. Spotless work — and almost invisible online. New business came from word of mouth and a prayer, while competitors with worse service and better SEO owned the map pack and took the calls.</p>
        <h3 class="mt-5 text-[11px] font-bold uppercase tracking-[0.16em] text-cyan">What we built</h3>
        <p class="mt-1.5 text-mute">The full Goliath Growth System, aimed at our own phone: a conversion-built website, neighborhood-level local SEO, a fully-managed Google Business Profile, and a review engine that turns every finished job into a fresh 5-star.</p>
        <h3 class="mt-5 text-[11px] font-bold uppercase tracking-[0.16em] text-cyan">The result</h3>
        <p class="mt-1.5 text-mute">#1 for the money keywords across Boca Raton and Delray Beach. A 5.0 rating built on 200 reviews. 60+ organic calls and 30+ web leads a month — without paying for a single click.</p>
      </div>

      <div class="grid grid-cols-2 gap-4 self-start">
        {fbpStats.map(([color, n, l]) => (
          <div class="rounded-2xl border border-line bg-mist p-5">
            <div class="text-[28px] font-black" style={`color:${color}`}>{n}</div>
            <div class="mt-1 text-sm text-mute">{l}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- testimonial -->
    <figure class="mt-10 rounded-[24px] border border-line bg-mist p-8">
      <div class="text-gold-deep">★★★★★</div>
      <blockquote class="mt-3 text-[18px] font-medium leading-relaxed text-navy">
        "Matt has been servicing my pool for seven years. He's kind, courteous, professional &amp; reliable.
        He always gets back to me promptly and he's always there when I need him. He does a great job with the
        weekly cleaning &amp; my pool always looks great!"
      </blockquote>
      <figcaption class="mt-3 text-sm text-mute">— Kathryn Feinberg, Google review</figcaption>
    </figure>

    <!-- real photos -->
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
      <div class="overflow-hidden rounded-2xl shadow-md shadow-navy/10"><Image src={teamFull} alt="The Florida's Best Pools team" class="h-56 w-full object-cover" loading="lazy" /></div>
      <div class="overflow-hidden rounded-2xl shadow-md shadow-navy/10"><Image src={techSkimming} alt="A technician skimming a pool" class="h-56 w-full object-cover" loading="lazy" /></div>
      <div class="overflow-hidden rounded-2xl shadow-md shadow-navy/10"><Image src={techTesting} alt="A technician testing pool water chemistry" class="h-56 w-full object-cover" loading="lazy" /></div>
    </div>
    <p class="mt-3 text-xs text-mute/80">Live Google rankings for floridasbestpools.com, mid-2026. Photos: Florida's Best Pools.</p>
  </section>

  <!-- ===== SECONDARY: DOLPHIN CLAIMS ===== -->
  <section id="dolphin" class="bg-mist">
    <div class="mx-auto max-w-[1320px] px-5 py-20">
      <span class="rounded-full bg-cyan/12 px-3 py-1 text-xs font-semibold text-cyan-deep">Insurance Tech</span>
      <h2 class="mt-3 font-black tracking-[-0.01em] text-navy" style="font-size: clamp(28px, 4.5vw, 42px)">Dolphin Claims</h2>
      <p class="mt-3 max-w-2xl text-mute">Not every job is a website. When an operator needs software, we build that too.</p>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-[11px] font-bold uppercase tracking-[0.16em] text-cyan">The problem</h3>
          <p class="mt-1.5 text-mute">Policyholder intake was slow, manual, and dead after hours — and every delay handed the claim to a faster competitor.</p>
          <h3 class="mt-5 text-[11px] font-bold uppercase tracking-[0.16em] text-cyan">What we built</h3>
          <p class="mt-1.5 text-mute">An AI claims assistant and ops platform: guided intake, document collection, and status updates — logged automatically, around the clock.</p>
        </div>
        <div class="grid grid-cols-3 content-start gap-4">
          {[['4x', 'Faster intake'], ['24/7', 'Response'], ['100%', 'Logged']].map(([n, l]) => (
            <div class="rounded-2xl border border-line bg-paper p-4 text-center">
              <div class="text-2xl font-black text-cyan-deep">{n}</div>
              <div class="mt-1 text-xs text-mute">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy px-5 py-20 text-center text-white">
    <div class="mx-auto max-w-[1320px]">
      <h2 class="font-black tracking-[-0.01em]" style="font-size: clamp(28px, 4.5vw, 42px)">Want to be the next case file?</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/75">We take a handful of new builds a month so every one gets our full attention. Grab your free game plan while there's room — backed by the 90-Day Ring Guarantee.</p>
      <a href={BOOKING_URL} class="mt-6 inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3.5 text-[16px] font-bold text-navy transition hover:bg-white">Claim your free game plan <Icon name="arrow" size={17} /></a>
    </div>
  </section>
</Layout>
