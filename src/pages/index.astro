---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import { PRICING, BOOKING_URL } from '../config';

import joeFord from '../assets/proof/joe-ford.jpg';
import cleanWater from '../assets/proof/clean-water.jpg';
import techSkimming from '../assets/proof/tech-skimming-pool.jpg';
import techTesting from '../assets/proof/tech-water-testing.jpg';
import teamMarina from '../assets/proof/team-marina-trio.jpg';

const faqItems = [
  { q: "What if I already have a website?", a: "Good — we'll show you exactly why it isn't ringing the phone, then rebuild it into something that does. You keep your domain and content; we make it work." },
  { q: 'How fast will I see results?', a: 'Your site launches in about two weeks. Google Business optimization and reviews start working day one. Local ranking movement typically shows within 60–90 days — which is why we back it with our 90-Day Ring Guarantee.' },
  { q: 'Do I own everything?', a: 'Yes. Your domain, your site, your Google profile, your data, your reviews. If you ever leave, it all goes with you. No hostage situations.' },
  { q: "Is this just another agency?", a: "No. We run our own businesses — including a South Florida pool company we ranked to the top of Google ourselves. You deal with the operator who built it, not an account manager reading a script." },
  { q: 'Is there a contract?', a: 'Month to month. We keep your business by earning it. The only lock-in is results.' },
  { q: 'What trades do you work with?', a: 'Pool service, plumbing, roofing, HVAC, electrical, landscaping, contractors, adjusters — if you run crews and answer phones, this was built for you.' },
];
---
<Layout
  title="Goliath Solutions — Be the First Call in Town | Websites, SEO & Marketing for the Trades"
  description={`We make the phone ring for blue collar businesses: a website that books jobs, top-of-Google local SEO, and reviews on autopilot — done for you for $${PRICING.monthly}/mo. Backed by a 90-Day Ring Guarantee.`}
  withSchema
>
  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden bg-deep text-white">
    <div class="pointer-events-none absolute -right-40 -top-40 size-[36rem] rounded-full bg-accent/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-52 -left-40 size-[32rem] rounded-full bg-gold/10 blur-3xl"></div>

    <div class="relative mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:py-28 lg:grid-cols-2 lg:items-center">
      <div class="rise">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm font-medium text-gold">
          ★★★★★ Built by operators who rank their own businesses
        </p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl">
          Be the first call<br />in town.
        </h1>
        <p class="mt-5 max-w-lg text-lg text-white/75">
          We make the phone ring for blue collar businesses. A website that books jobs, top-of-Google
          local SEO, and 5-star reviews on autopilot — all handled for you, for less than one lost job a month.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={BOOKING_URL} class="rounded-full bg-accent px-6 py-3 text-lg font-semibold text-white transition hover:bg-accent/90">
            Claim your free game plan →
          </a>
          <a href="#included" class="rounded-full border border-white/25 px-6 py-3 text-lg font-semibold transition hover:bg-white/10">
            See what you get
          </a>
        </div>
        <p class="mt-4 text-sm text-white/50">Free 30-min call. No pressure. No jargon. Backed by our 90-Day Ring Guarantee.</p>
      </div>

      <!-- Real proof, rendered as a live Google result -->
      <div class="rise rounded-2xl bg-white p-5 text-ink shadow-2xl shadow-black/40 [animation-delay:0.15s]">
        <div class="flex items-center gap-2 border-b border-ink/10 pb-3 text-sm text-ink/50">
          <span class="text-accent">🔍</span> pool service boca raton
        </div>
        <div class="mt-3 rounded-xl border border-ink/10 p-4">
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-accent/10 px-2 py-0.5 text-xs font-bold text-accent">#1 · Map pack</span>
          </div>
          <p class="mt-2 font-bold">Florida's Best Pools</p>
          <p class="text-sm text-gold">★★★★★ <span class="text-ink/70">5.0 · 197 Google reviews</span></p>
          <p class="mt-1 text-sm text-ink/60">Pool service · Boca Raton, FL · Open 24 hrs</p>
        </div>
        <p class="mt-4 text-center text-xs font-medium text-ink/50">
          A real business we built and rank — <span class="text-ink">our own</span>.
        </p>
      </div>
    </div>

    <!-- trust bar -->
    <div class="relative border-t border-white/10 bg-black/20">
      <div class="mx-auto max-w-6xl px-5 py-6">
        <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
          <div><div class="text-2xl font-bold text-gold">197</div><div class="text-xs text-white/60">5-star reviews</div></div>
          <div><div class="text-2xl font-bold text-gold">10,000+</div><div class="text-xs text-white/60">pools serviced</div></div>
          <div><div class="text-2xl font-bold text-gold">#1</div><div class="text-xs text-white/60">on Google, local</div></div>
          <div><div class="text-2xl font-bold text-gold">14 yrs</div><div class="text-xs text-white/60">running real businesses</div></div>
        </div>
        <p class="mt-4 text-center text-xs text-white/40">Real numbers from Florida's Best Pools — the South Florida pool company we run and rank.</p>
      </div>
    </div>
  </section>

  <!-- ===== PAIN ===== -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <p class="text-center font-semibold text-accent">The problem isn't your work.</p>
    <h2 class="mx-auto mt-2 max-w-2xl text-center text-3xl font-bold sm:text-4xl">
      You're the best in town. Google doesn't know it yet.
    </h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl bg-paper p-6">
        <div class="text-3xl">🕳️</div>
        <h3 class="mt-3 font-bold">Invisible online</h3>
        <p class="mt-2 text-sm text-ink/70">The guy with worse work but a better Google profile is taking the calls that should be yours. Ranking is a system — not luck, not who's oldest.</p>
      </div>
      <div class="rounded-2xl bg-paper p-6">
        <div class="text-3xl">📵</div>
        <h3 class="mt-3 font-bold">Leads slipping away</h3>
        <p class="mt-2 text-sm text-ink/70">Every missed call dials the next name on the list. If capture and follow-up depend on whoever's near the phone, you're losing jobs you already paid to earn.</p>
      </div>
      <div class="rounded-2xl bg-paper p-6">
        <div class="text-3xl">💸</div>
        <h3 class="mt-3 font-bold">Agencies that don't get it</h3>
        <p class="mt-2 text-sm text-ink/70">$5,000 builds, $2,000/mo retainers, jargon reports — and a site that still doesn't ring. You want a straight price and a phone that rings. Fair.</p>
      </div>
    </div>
  </section>

  <!-- ===== THE OFFER ===== -->
  <section id="included" class="bg-deep text-white">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="text-center">
        <p class="font-semibold uppercase tracking-widest text-gold">The Goliath Growth System</p>
        <h2 class="mx-auto mt-2 max-w-2xl text-3xl font-bold sm:text-4xl">
          One system that turns your name into the first call.
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">Five things every service business needs to win online — built, wired together, and run for you.</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ['🌐', 'A website that books jobs', 'Fast, clean, one job: turn a visitor into a booked call. Loads in under a second.'],
          ['🔍', 'Local SEO, managed monthly', 'Neighborhood-level targeting so you show up for "your trade near me." Worked every month, not set-and-forget.'],
          ['📍', 'Google Business Profile', 'Optimized, posted to, and maintained. The map pack is where local jobs are won.'],
          ['⭐', 'Reviews on autopilot', 'Every finished job triggers a review ask that doesn’t feel spammy. Your rating climbs while you work.'],
          ['📞', 'Lead capture + follow-up', 'Quote forms and call tracking wired so nothing slips. Fast follow-up wins the job.'],
          ['📊', 'Plain-English reporting', 'One monthly report: calls, leads, rankings, reviews. No vanity metrics, no jargon.'],
        ].map(([icon, title, body]) => (
          <div class="rounded-2xl bg-white/5 p-6 transition hover:bg-white/10">
            <div class="text-3xl">{icon}</div>
            <h3 class="mt-3 font-bold">{title}</h3>
            <p class="mt-2 text-sm text-white/70">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PRICING / VALUE STACK ===== -->
  <section id="pricing" class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-center text-3xl font-bold sm:text-4xl">Add it up. Then look at the price.</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-ink/70">
        Agencies charge $5,000+ to build and $2,000+/month to "manage." We built a leaner system and pass the savings straight to you.
      </p>
      <div class="mt-12"><PricingCard /></div>
      <p class="mx-auto mt-8 max-w-xl text-center text-sm text-ink/60">
        Bigger project — a custom app, an AI agent, automation? We build those too.
        <a href="/contact" class="font-semibold text-accent">Tell us where it hurts →</a>
      </p>
    </div>
  </section>

  <!-- ===== FLAGSHIP PROOF: FLORIDA'S BEST POOLS ===== -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="font-semibold text-accent">We don't just talk. We rank our own company.</p>
        <h2 class="mt-2 text-3xl font-bold sm:text-4xl">Florida's Best Pools</h2>
        <p class="mt-4 text-ink/70">
          Our founder Joe is a partner in a South Florida pool company. We put the exact same system to work on it —
          website, local SEO, Google profile, reviews. Today it owns the map in Boca Raton and Delray Beach.
          If it works for our own phone, it'll work for yours.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-ink/10 p-5">
            <div class="text-3xl font-bold text-accent">#1</div>
            <div class="mt-1 text-sm text-ink/60">on Google for <span class="font-medium text-ink">"best florida pools"</span> — up from #7</div>
          </div>
          <div class="rounded-2xl border border-ink/10 p-5">
            <div class="text-3xl font-bold text-accent">#2</div>
            <div class="mt-1 text-sm text-ink/60">for <span class="font-medium text-ink">"pool heater maintenance"</span> — 1,600 searches/mo</div>
          </div>
          <div class="rounded-2xl border border-ink/10 p-5">
            <div class="text-3xl font-bold text-accent">Top 3</div>
            <div class="mt-1 text-sm text-ink/60">across Boca Raton &amp; Delray Beach pool searches</div>
          </div>
          <div class="rounded-2xl border border-ink/10 p-5">
            <div class="text-3xl font-bold text-gold">★ 5.0</div>
            <div class="mt-1 text-sm text-ink/60">197 Google reviews and climbing</div>
          </div>
        </div>
        <p class="mt-4 text-xs text-ink/40">Live Google rankings for floridasbestpools.com, mid-2026.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-2xl">
          <Image src={cleanWater} alt="Crystal-clear serviced pool water" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-8 overflow-hidden rounded-2xl">
          <Image src={techSkimming} alt="Technician skimming a pool" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="overflow-hidden rounded-2xl">
          <Image src={techTesting} alt="Technician testing pool water chemistry" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="mt-8 overflow-hidden rounded-2xl">
          <Image src={teamMarina} alt="The Florida's Best Pools team" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RISK REVERSAL ===== -->
  <section class="bg-gold/10">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-5 py-16 text-center">
      <div class="text-5xl">🛡️</div>
      <h2 class="text-3xl font-bold sm:text-4xl">The 90-Day Ring Guarantee</h2>
      <p class="max-w-2xl text-lg text-ink/75">
        If your phone isn't ringing with new leads within 90 days of launch, we keep working for free until it does.
        We take the risk so you don't have to. That's how sure we are.
      </p>
      <a href={BOOKING_URL} class="mt-2 rounded-full bg-ink px-6 py-3 font-semibold text-white transition hover:bg-ink/90">
        Book your free game plan →
      </a>
    </div>
  </section>

  <!-- ===== BEFORE / AFTER ===== -->
  <section class="mx-auto max-w-5xl px-5 py-20">
    <h2 class="text-center text-3xl font-bold sm:text-4xl">Two ways to do this.</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-ink/10 p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-ink/40">The old way</p>
        <ul class="mt-4 space-y-3 text-ink/70">
          <li class="flex gap-2"><span class="text-ink/30">✕</span> $5,000–$12,000 to build, $2,000+/mo to "manage"</li>
          <li class="flex gap-2"><span class="text-ink/30">✕</span> Sold by a salesperson, built by a stranger overseas</li>
          <li class="flex gap-2"><span class="text-ink/30">✕</span> Jargon reports you can't read</li>
          <li class="flex gap-2"><span class="text-ink/30">✕</span> Locked in a 12-month contract</li>
          <li class="flex gap-2"><span class="text-ink/30">✕</span> A pretty site that still doesn't ring</li>
        </ul>
      </div>
      <div class="rounded-3xl border-2 border-accent bg-accent/5 p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent">The Goliath way</p>
        <ul class="mt-4 space-y-3 font-medium">
          <li class="flex gap-2"><span class="text-accent">✓</span> ${PRICING.setup.toLocaleString()} to build, ${PRICING.monthly}/mo — all in</li>
          <li class="flex gap-2"><span class="text-accent">✓</span> Built and run by the operator who ranks his own business</li>
          <li class="flex gap-2"><span class="text-accent">✓</span> One plain-English report a month</li>
          <li class="flex gap-2"><span class="text-accent">✓</span> Month to month — you own everything</li>
          <li class="flex gap-2"><span class="text-accent">✓</span> A system built to ring the phone, guaranteed</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS ===== -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-center text-3xl font-bold sm:text-4xl">Live in about two weeks.</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-4">
        {[
          ['01', 'Free game plan', 'A 30-minute call. Your market, your bottlenecks, your fastest wins — no pitch theater.'],
          ['02', 'We build', 'Website up, Google profile tuned, reviews and lead capture switched on. ~2 weeks.'],
          ['03', 'Launch', 'You go live and start showing up where local jobs are won.'],
          ['04', 'We run it', 'SEO, reviews, marketing — handled monthly, reported in plain English.'],
        ].map(([num, title, body]) => (
          <div class="rounded-2xl border border-ink/10 bg-white p-6">
            <div class="text-sm font-bold text-accent">{num}</div>
            <h3 class="mt-1 font-bold">{title}</h3>
            <p class="mt-2 text-sm text-ink/70">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FOUNDER ===== -->
  <section class="mx-auto max-w-4xl px-5 py-20">
    <div class="flex flex-col items-center gap-6 text-center">
      <div class="size-28 overflow-hidden rounded-full ring-4 ring-paper">
        <Image src={joeFord} alt="Joe Ford, founder of Goliath Solutions" class="h-full w-full object-cover" loading="lazy" />
      </div>
      <blockquote class="max-w-2xl text-xl font-medium">
        "I've spent 14 years running real businesses — including a pool company we ranked to #1 in South Florida
        ourselves. I know what it's like to lose a job because your site looked like 2009 and your phone rang while
        you were on a roof. That's exactly what this fixes."
      </blockquote>
      <p class="text-sm text-ink/60">Joe Ford, founder — Goliath Solutions</p>
      <a href="/about" class="font-semibold text-accent">Read the story →</a>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-paper">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <h2 class="text-center text-3xl font-bold sm:text-4xl">Straight answers.</h2>
      <div class="mt-10"><FAQ items={faqItems} /></div>
    </div>
  </section>

  <!-- ===== URGENCY + FINAL CTA ===== -->
  <section class="bg-deep text-center text-white">
    <div class="mx-auto max-w-3xl px-5 py-20">
      <p class="font-semibold uppercase tracking-widest text-gold">We take on a handful of new builds a month</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">Let's make your business the first call in town.</h2>
      <p class="mt-3 text-white/70">
        Free game plan. No pressure. If we're not the right fit, we'll tell you who is. Backed by our 90-Day Ring Guarantee.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={BOOKING_URL} class="rounded-full bg-accent px-6 py-3 text-lg font-semibold text-white transition hover:bg-accent/90">Claim your free game plan →</a>
        <a href="/contact" class="rounded-full border border-white/30 px-6 py-3 text-lg font-semibold transition hover:bg-white/10">Get a quote</a>
      </div>
    </div>
  </section>
</Layout>
