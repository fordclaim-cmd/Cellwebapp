---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { PRICING, BOOKING_URL } from '../config';

import heroPool from '../assets/proof/hero-banner-pool.jpg';
import fbpSite from '../assets/proof/fbp-site.jpeg';
import joeFord from '../assets/proof/joe-ford.jpg';
import cleanWater from '../assets/proof/clean-water.jpg';
import techSkimming from '../assets/proof/tech-skimming-pool.jpg';
import techTesting from '../assets/proof/tech-water-testing.jpg';
import teamMarina from '../assets/proof/team-marina-trio.jpg';

const perks = [
  ['globe', '#1196cc', 'A website that books jobs', 'Fast, clean, one job: turn a visitor into a booked call. Loads in under a second.', '<1s', 'Load time'],
  ['search', '#0d7aa8', 'Local SEO, managed monthly', 'Neighborhood-level targeting so you show up for "your trade near me." Worked every month.', '#1', 'Local goal'],
  ['pin', '#f6bb06', 'Google Business Profile', 'Optimized, posted to, and maintained. The map pack is where local jobs are won.', 'Map', 'Pack owned'],
  ['star', '#002d5e', 'Reviews on autopilot', 'Every finished job triggers a review ask that doesn’t feel spammy. Your rating climbs while you work.', '5.0', 'Star target'],
  ['phone', '#1196cc', 'Lead capture + follow-up', 'Quote forms and call tracking wired so nothing slips. Fast follow-up wins the job.', '0', 'Leads lost'],
  ['chart', '#f6bb06', 'Plain-English reporting', 'One monthly report: calls, leads, rankings, reviews. No vanity metrics, no jargon.', '1/mo', 'Clear report'],
];

const milestones = [
  ['01', '#1196cc', 'Free game plan', 'A 30-minute call. Your market, your bottlenecks, your fastest wins — no pitch theater.'],
  ['02', '#1196cc', 'We build', 'Website up, Google profile tuned, reviews and lead capture switched on. ~2 weeks.'],
  ['03', '#0d7aa8', 'Launch', 'You go live and start showing up where local jobs are won.'],
  ['04', '#f6bb06', 'We run it', 'SEO, reviews, marketing — handled monthly, reported in plain English.'],
];

const faqItems = [
  { q: "What if I already have a website?", a: "Good — we'll show you exactly why it isn't ringing the phone, then rebuild it into something that does. You keep your domain and content; we make it work." },
  { q: 'How fast will I see results?', a: 'Your site launches in about two weeks. Google Business optimization and reviews start working day one. Local ranking movement typically shows within 60–90 days — which is why we back it with our 90-Day Ring Guarantee.' },
  { q: 'Do I own everything?', a: 'Yes. Your domain, your site, your Google profile, your data, your reviews. If you ever leave, it all goes with you. No hostage situations.' },
  { q: "Is this just another agency?", a: "No. We run our own businesses — including a South Florida pool company we ranked to the top of Google ourselves. You deal with the operator who built it, not an account manager reading a script." },
  { q: 'Is there a contract?', a: 'Month to month. We keep your business by earning it. The only lock-in is results.' },
  { q: 'What trades do you work with?', a: 'Pool service, plumbing, roofing, HVAC, electrical, landscaping, contractors, adjusters — if you run crews and answer phones, this was built for you.' },
];
---
<Layout
  title="Goliath Solutions — Be the First Call in Town | Websites, SEO & Marketing for the Trades"
  description={`We make the phone ring for blue collar businesses: a website that books jobs, top-of-Google local SEO, and reviews on autopilot — done for you for $${PRICING.monthly}/mo. Backed by a 90-Day Ring Guarantee.`}
  withSchema
>
  <!-- ===== HERO (full-bleed photo) ===== -->
  <section class="relative isolate overflow-hidden">
    <Image src={heroPool} alt="A pristine South Florida pool" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="eager" />
    <div class="absolute inset-0 -z-10" style="background: linear-gradient(100deg, rgba(0,26,55,0.94) 0%, rgba(0,45,94,0.82) 45%, rgba(0,45,94,0.35) 100%)"></div>

    <div class="mx-auto grid max-w-[1320px] gap-10 px-5 py-16 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="rise text-white">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[12px] font-semibold uppercase tracking-[0.12em] text-white backdrop-blur">
          <span class="text-gold"><Icon name="star" size={13} /></span> Operators who rank their own businesses
        </p>
        <h1 class="mt-5 font-black leading-[0.95] tracking-[-0.02em]" style="font-size: clamp(44px, 7vw, 88px)">
          Be the first call<br /><span class="text-cyan" style="text-shadow: 0 2px 20px rgba(17,150,204,0.5)">in town.</span>
        </h1>
        <p class="mt-6 max-w-lg text-[18px] leading-relaxed text-white/85">
          We make the phone ring for blue collar businesses. A website that books jobs, top-of-Google
          local SEO, and 5-star reviews on autopilot — all handled for you, for less than one lost job a month.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3.5 text-[16px] font-bold text-navy transition hover:bg-white" style="box-shadow: 0 14px 28px rgba(0,0,0,0.3)">
            Claim your free game plan <Icon name="arrow" size={17} />
          </a>
          <a href="#included" class="inline-flex items-center rounded-full border border-white/40 px-7 py-3.5 text-[16px] font-semibold text-white transition hover:bg-white/10">
            See what you get
          </a>
        </div>
        <p class="mt-4 text-sm text-white/60">Free 30-min call. No pressure. No jargon. Backed by our 90-Day Ring Guarantee.</p>
      </div>

      <!-- Right column: Google proof card + "what we can do for you" site preview -->
      <div class="rise space-y-4 [animation-delay:0.15s]">
        <div class="rounded-[20px] bg-paper p-5 shadow-2xl shadow-navy-deep/40">
          <div class="flex items-center gap-2 border-b border-line pb-3 text-sm text-mute">
            <Icon name="search" size={15} class="text-cyan" /> pool service boca raton
          </div>
          <div class="mt-3 rounded-xl border border-line bg-mist p-4">
            <span class="rounded-full bg-cyan/15 px-2 py-0.5 text-xs font-bold text-cyan-deep">#1 · Map pack</span>
            <p class="mt-2 font-bold text-navy">Florida's Best Pools</p>
            <p class="text-sm text-gold-deep">★★★★★ <span class="text-mute">5.0 · 200 Google reviews</span></p>
            <p class="mt-1 text-sm text-mute">Pool service · Boca Raton, FL · Open 24 hrs</p>
          </div>
        </div>

        <!-- Real site we built — "what we can do for you" -->
        <a href="https://floridasbestpools.com" target="_blank" rel="noopener" class="block overflow-hidden rounded-[20px] bg-paper shadow-2xl shadow-navy-deep/40">
          <div class="flex items-center gap-1.5 border-b border-line bg-mist px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-red-400"></span>
            <span class="size-2.5 rounded-full bg-yellow-400"></span>
            <span class="size-2.5 rounded-full bg-green-400"></span>
            <span class="ml-2 truncate text-xs text-mute">floridasbestpools.com</span>
          </div>
          <Image src={fbpSite} alt="A website Goliath built and ranks — Florida's Best Pools homepage" class="w-full" loading="lazy" />
          <div class="flex items-center justify-between gap-2 px-4 py-3">
            <p class="text-xs font-semibold text-navy">What we can do for you — a real site we built &amp; rank.</p>
            <span class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-cyan-deep">See it live <Icon name="arrow" size={13} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- trust strip -->
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-[1320px] px-5 py-8">
      <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        {[['200', '5-star reviews'], ['10,000+', 'pools serviced'], ['#1', 'on Google, local'], ['14 yrs', 'running businesses']].map(([n, l]) => (
          <div>
            <div class="font-black tracking-[-0.02em] text-navy" style="font-size: clamp(26px, 4vw, 40px)">{n}</div>
            <div class="mx-auto mt-2 h-0.5 w-12 rounded bg-cyan"></div>
            <div class="mt-2 text-[11px] uppercase tracking-[0.16em] text-mute">{l}</div>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-xs text-mute/80">Real numbers from Florida's Best Pools — the South Florida pool company we run and rank.</p>
    </div>
  </section>

  <!-- ===== PAIN ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">The problem isn't your work.</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
        You're the best in town. Google doesn't know it yet.
      </h2>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        {[
          ['search', 'Invisible online', "The guy with worse work but a better Google profile is taking the calls that should be yours. Ranking is a system — not luck, not who's oldest."],
          ['phone', 'Leads slipping away', "Every missed call dials the next name on the list. If capture and follow-up depend on whoever's near the phone, you're losing jobs you already paid to earn."],
          ['dollar', "Agencies that don't get it", '$5,000 builds, $2,000/mo retainers, jargon reports — and a site that still doesn\'t ring. You want a straight price and a phone that rings. Fair.'],
        ].map(([icon, title, body]) => (
          <div class="rounded-[20px] border border-line bg-mist p-7">
            <span class="inline-grid size-14 place-items-center rounded-2xl bg-cyan/10 text-cyan" style="border: 1.5px solid rgba(17,150,204,0.25)"><Icon name={icon} size={26} /></span>
            <h3 class="mt-4 text-[20px] font-black text-navy">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mute">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== THE OFFER (6-up perk grid) ===== -->
  <section id="included" class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <div class="text-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-gold-deep">★ The Goliath Growth System</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
          One system that turns your name into <span class="text-cyan">the first call.</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-mute">Everything a service business needs to win online — built, wired together, and run for you.</p>
      </div>

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {perks.map(([icon, color, title, body, stat, statLabel]) => (
          <div class="group flex h-full flex-col rounded-[20px] border border-line bg-paper p-7 shadow-sm shadow-navy/5 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-navy/10">
            <span class="inline-grid size-14 place-items-center rounded-2xl" style={`color:${color}; background:${color}14; border:1.5px solid ${color}40`}><Icon name={icon} size={28} /></span>
            <h3 class="mt-4 text-[20px] font-black text-navy">{title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{body}</p>
            <div class="mt-5 flex items-end justify-between border-t border-line pt-4">
              <div>
                <div class="text-[26px] font-black" style={`color:${color}`}>{stat}</div>
                <div class="text-[10px] uppercase tracking-[0.18em] text-mute">{statLabel}</div>
              </div>
              <Icon name="arrow" size={20} class="text-line" />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PRICING / VALUE STACK ===== -->
  <section id="pricing" class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <h2 class="text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Add it up. Then look at the price.</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-mute">
        Agencies charge $5,000+ to build and $2,000+/month to "manage." We built a leaner system and pass the savings straight to you.
      </p>
      <div class="mt-14"><PricingCard /></div>
      <p class="mx-auto mt-8 max-w-xl text-center text-sm text-mute">
        Bigger project — a custom app, an AI agent, automation? We build those too.
        <a href="/contact" class="font-semibold text-cyan-deep">Tell us where it hurts →</a>
      </p>
    </div>
  </section>

  <!-- ===== FLAGSHIP PROOF: FLORIDA'S BEST POOLS ===== -->
  <section class="bg-mist px-5 py-24">
    <div class="mx-auto grid max-w-[1320px] gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">We don't just talk. We rank our own company.</p>
        <h2 class="mt-3 font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Florida's Best Pools</h2>
        <p class="mt-4 leading-relaxed text-mute">
          Our founder Joe is a partner in a South Florida pool company. We put the exact same system to work on it —
          website, local SEO, Google profile, reviews. Today it owns the map in Boca Raton and Delray Beach.
          If it works for our own phone, it'll work for yours.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          {[['#1196cc', '#1', 'on Google for "best florida pools" — up from #7'],
            ['#1196cc', '#2', 'for "pool heater maintenance" — 1,600 searches/mo'],
            ['#1196cc', 'Top 3', 'across Boca Raton & Delray Beach pool searches'],
            ['#a37c08', '★ 5.0', '200 Google reviews and climbing']].map(([color, n, l]) => (
            <div class="rounded-2xl border border-line bg-paper p-5">
              <div class="text-[28px] font-black" style={`color:${color}`}>{n}</div>
              <div class="mt-1 text-sm text-mute">{l}</div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-mute/80">Live Google rankings for floridasbestpools.com, mid-2026.</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={cleanWater} alt="Crystal-clear serviced pool water" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="mt-8 overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={techSkimming} alt="Technician skimming a pool" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={techTesting} alt="Technician testing pool water chemistry" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="mt-8 overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={teamMarina} alt="The Florida's Best Pools team" class="h-full w-full object-cover" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- ===== RISK REVERSAL ===== -->
  <section class="bg-navy px-5 py-16 text-white">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
      <span class="grid size-16 place-items-center rounded-2xl bg-gold/15 text-gold" style="border: 1.5px solid rgba(246,187,6,0.4)"><Icon name="shield" size={32} /></span>
      <h2 class="font-black tracking-[-0.01em]" style="font-size: clamp(28px, 4vw, 40px)">The 90-Day Ring Guarantee</h2>
      <p class="max-w-2xl text-[18px] leading-relaxed text-white/80">
        If your phone isn't ringing with new leads within 90 days of launch, we keep working for free until it does.
        We take the risk so you don't have to. That's how sure we are.
      </p>
      <a href={BOOKING_URL} class="mt-2 inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 font-bold text-navy transition hover:bg-white">
        Book your free game plan <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ===== BEFORE / AFTER ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Two ways to do this.</h2>
      <div class="mt-14 grid gap-5 md:grid-cols-2">
        <div class="rounded-[24px] border border-line bg-mist p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-mute">The old way</p>
          <ul class="mt-5 space-y-3 text-mute">
            {['$5,000–$12,000 to build, $2,000+/mo to "manage"', 'Sold by a salesperson, built by a stranger overseas', "Jargon reports you can't read", 'Locked in a 12-month contract', "A pretty site that still doesn't ring"].map((t) => (
              <li class="flex gap-2.5"><span class="text-mute/40">✕</span> {t}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-[24px] border-2 border-cyan bg-paper p-8 shadow-lg shadow-cyan/10">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-cyan-deep">The Goliath way</p>
          <ul class="mt-5 space-y-3 font-medium text-navy">
            {[`$${PRICING.setup.toLocaleString()} to build, $${PRICING.monthly}/mo — all in`, 'Built and run by the operator who ranks his own business', 'One plain-English report a month', 'Month to month — you own everything', 'A system built to ring the phone, guaranteed'].map((t) => (
              <li class="flex gap-2.5"><span class="mt-0.5 inline-grid size-4 shrink-0 place-items-center rounded-full bg-cyan text-white"><Icon name="check" size={9} /></span> {t}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROCESS (milestone rail) ===== -->
  <section class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">How it works</p>
      <h2 class="mt-3 text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Live in about two weeks.</h2>
      <div class="relative mt-16">
        <div class="absolute left-0 right-0 top-9 hidden h-1.5 rounded-full md:block bg-line"></div>
        <div class="absolute left-0 right-0 top-9 hidden h-1.5 rounded-full md:block" style="background: linear-gradient(90deg, #1196cc 0%, #0d7aa8 55%, #f6bb06 100%)"></div>
        <div class="relative grid gap-10 md:grid-cols-4">
          {milestones.map(([num, color, title, body]) => (
            <div class="text-center">
              <div class="mx-auto grid size-[72px] place-items-center rounded-full bg-paper text-[18px] font-black" style={`border:4px solid ${color}; color:${color}`}>{num}</div>
              <h3 class="mt-4 text-[17px] font-bold uppercase tracking-[0.08em] text-navy">{title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-mute">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOUNDER ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center">
      <div class="size-28 overflow-hidden rounded-full ring-4 ring-cyan/25">
        <Image src={joeFord} alt="Joe Ford, founder of Goliath Solutions" class="h-full w-full object-cover" loading="lazy" />
      </div>
      <blockquote class="max-w-2xl text-[22px] font-medium leading-relaxed text-navy">
        "I've spent 14 years running real businesses — including a pool company we ranked to #1 in South Florida
        ourselves. I know what it's like to lose a job because your site looked like 2009 and your phone rang while
        you were on a roof. That's exactly what this fixes."
      </blockquote>
      <p class="text-sm text-mute">Joe Ford, founder — Goliath Solutions</p>
      <a href="/about" class="inline-flex items-center gap-1.5 font-semibold text-cyan-deep">Read the story <Icon name="arrow" size={15} /></a>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">★ Straight answers</p>
      <h2 class="mt-3 text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Questions answered.</h2>
      <div class="mt-12"><FAQ items={faqItems} /></div>
    </div>
  </section>

  <!-- ===== FINAL CTA (navy band) ===== -->
  <section class="bg-navy px-5 py-24">
    <div class="relative mx-auto max-w-[1100px] overflow-hidden rounded-[32px] p-10 text-center md:p-16" style="background: linear-gradient(135deg, #002d5e 0%, #001a37 100%); box-shadow: 0 40px 80px rgba(0,0,0,0.3)">
      <div class="pointer-events-none absolute -right-20 -top-20 size-80 rounded-full" style="background: rgba(17,150,204,0.18)"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-20 size-80 rounded-full" style="background: rgba(246,187,6,0.1)"></div>
      <div class="relative text-white">
        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">★ We take a handful of new builds a month ★</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-black tracking-[-0.02em]" style="font-size: clamp(32px, 6vw, 60px)">Make your business the first call in town.</h2>
        <p class="mx-auto mt-4 max-w-xl text-[17px] text-white/80">
          Free game plan. No pressure. If we're not the right fit, we'll tell you who is. Backed by our 90-Day Ring Guarantee.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3.5 text-[16px] font-bold text-navy transition hover:bg-white">Claim your free game plan <Icon name="arrow" size={17} /></a>
          <a href="/contact" class="inline-flex items-center rounded-full border border-white/40 px-7 py-3.5 text-[16px] font-semibold text-white transition hover:bg-white/10">Get a quote</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
