---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PricingCard from '../components/PricingCard.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { PRICING, BOOKING_URL } from '../config';

import joeHero from '../assets/proof/joe-hero.png';
import fbpSite from '../assets/proof/fbp-site.jpeg';
import joeFord from '../assets/proof/joe-ford.jpg';
import cleanWater from '../assets/proof/clean-water.jpg';
import techSkimming from '../assets/proof/tech-skimming-pool.jpg';
import techTesting from '../assets/proof/tech-water-testing.jpg';
import teamMarina from '../assets/proof/team-marina-trio.jpg';

const perks = [
  ['search', '#0d7aa8', 'Local SEO & the Map Pack', 'The top 3 of Google Maps is where local jobs are won. Hyper-local pages, worked every month — this is the channel that never stops ringing once you own it.', '#1', 'The goal'],
  ['globe', '#1196cc', 'A website that books jobs', 'Not a brochure — a 24/7 lead machine. Call-first buttons, quote form, built to book the 9pm emergency caller. Loads in under two seconds.', '<2s', 'Load time'],
  ['pin', '#f6bb06', 'Google Business Profile', 'Optimized, posted to, and maintained — because the map pack is won or lost on your profile, not your website.', 'Map', 'Pack owned'],
  ['star', '#002d5e', 'Reviews on autopilot', 'Every finished job triggers a review ask that doesn’t feel spammy. Your rating climbs while you work. Ours hit 200.', '5.0', 'Star target'],
  ['phone', '#1196cc', 'Lead capture + follow-up', 'Quote forms and call tracking wired so nothing slips. The first company to respond wins the job — that’ll be you.', '0', 'Leads lost'],
  ['target', '#0d7aa8', 'Local Service Ads', 'Google-Guaranteed leads at the very top of search. We set them up, manage the budget, and dispute junk — you pay per lead, not per click.', 'PPL', 'Pay per lead'],
  ['chart', '#f6bb06', 'Plain-English reporting', 'One monthly report: calls, leads, rankings, reviews. If a number doesn’t connect to booked work, we don’t report it.', '1/mo', 'Real numbers'],
];

const phases = [
  {
    num: '01', when: 'WEEK 1', color: '#1196cc', title: 'Audit & game plan',
    body: "A 30-minute call where we reverse-engineer your business: your service area, your average ticket, where your leads actually come from today. Then we audit your site and Google profile for the leaks — broken tracking, keyword gaps, competitor openings.",
    payoff: 'You walk away with a custom game plan for your market. Yours to keep, even if we never work together.',
  },
  {
    num: '02', when: 'DAYS 7–30', color: '#1196cc', title: 'Foundation build',
    body: 'We rebuild the stack: conversion-built site live, Google Business Profile optimized, review engine and lead tracking switched on, local service pages launched.',
    payoff: 'Your new site and profile start converting the demand you already have — from day one.',
  },
  {
    num: '03', when: 'DAYS 31–90', color: '#0d7aa8', title: 'Scale & optimize',
    body: "Now we pour fuel on what's working and cut what isn't. Reviews compound, rankings climb, follow-up tightens. This is the window our 90-Day Ring Guarantee covers: if the phone isn't ringing, we work free until it is.",
    payoff: 'Lead flow you can feel — and a report you can actually read.',
  },
  {
    num: '04', when: 'MONTH 4+', color: '#f6bb06', title: 'Own the map',
    body: "Real map-pack movement lands months 4–6, depending on how competitive your market is. Anyone promising the 3-pack in 30 days is lying to you. When it lands, we expand — more neighborhoods, more service pages, more of the metro.",
    payoff: 'By the time competitors figure out what you did, you already own the market.',
  },
];

const compareRows = [
  ['Contract', '12–24 month lock-in', 'Month to month. Cancel anytime.'],
  ['Built by', 'Career marketers who’ve never run a crew', 'An operator who ranks his own company'],
  ['Your contact', 'An account manager reading a script', 'Joe — the guy who built the system'],
  ['Proof', 'Stock-photo portfolios', 'Our own company: #1 on Google, 200 reviews'],
  ['Reporting', 'Impressions, reach, and jargon', 'Calls, leads, rankings — plain English'],
  ['Pricing', '“Book a call to find out”', `$${PRICING.setup.toLocaleString()} build + $${PRICING.monthly}/mo, right on the site`],
  ['Who owns your stuff', 'They do — leave and lose it', 'You do. Domain, site, profile, reviews.'],
];

const faqItems = [
  { q: "How are you different from every agency that's pitched me?", a: "One thing, mostly: we're operators. Our founder ran real businesses for 14 years and is a partner in Florida's Best Pools — a South Florida pool company we ranked to #1 on Google with 200 five-star reviews, using the exact system on this page. We don't sell you a playbook we read about. We sell you the one that runs our own phone." },
  { q: 'How long before my phone rings?', a: "Straight answer: your new site and Google profile start converting existing demand the day they go live — about two weeks in. Reviews and lead capture work from day one. Real map-pack movement takes months 4–6 depending on your market, and anyone promising it faster is lying. That's why the 90-Day Ring Guarantee exists: new leads within 90 days or we work free until you get them." },
  { q: "I've been burned by an agency before. Why should I trust you?", a: "That's exactly why Goliath is built the way it is. Month to month — leaving is easy, so we have to earn every month. Transparent pricing — no discovery-call ambush. You own everything — domain, site, profile, reviews. And the proof isn't a client logo wall, it's our own company ranked #1. The risk sits on our side of the table, where it belongs." },
  { q: 'What does it cost?', a: `$${PRICING.setup.toLocaleString()} to build, $${PRICING.monthly}/month to run — it's printed on this page because "call for pricing" is an agency game. The monthly covers the whole system: hosting, local SEO, Google profile, reviews, lead capture, and the monthly report. Local Service Ads budget is separate — that money goes to Google, not us.` },
  { q: 'Do I have to sign a contract?', a: "No. Month to month, cancel anytime. We keep your business by making your phone ring, not by making you sign a 12-month agreement on day one." },
  { q: 'Do you do social media, video, or Google Ads?', a: "The core system — site, local SEO, Google profile, reviews, lead capture, Local Service Ads — is us. Social media marketing, video production, and Google Ads run through vetted partners we manage, added only when your market actually calls for them. You get one point of contact either way: us." },
  { q: 'What trades do you work with?', a: 'Pool service, plumbing, roofing, HVAC, electrical, landscaping, contractors, adjusters — if you run crews and answer phones, this was built for you.' },
  { q: 'Do I own everything?', a: 'Yes. Your domain, your site, your Google profile, your data, your reviews. If you ever leave, it all goes with you. No hostage situations.' },
];
---
<Layout
  title="Goliath Solutions — Be the First Call in Town | Websites, SEO & Marketing for the Trades"
  description={`We make the phone ring for blue collar businesses: a website that books jobs, top-of-Google local SEO, and reviews on autopilot — done for you for $${PRICING.monthly}/mo. Backed by a 90-Day Ring Guarantee.`}
  withSchema
>
  <!-- ===== HERO (founder) ===== -->
  <section class="relative isolate overflow-hidden bg-navy">
    <!-- MOBILE: photo with eyebrow + headline overlaid at the bottom (clear of Joe's face up top) -->
    <div class="relative lg:hidden">
      <Image src={joeHero} alt="Joe Ford, founder of Goliath Solutions, outside a South Florida waterfront home" class="h-[440px] w-full object-cover object-[16%_16%]" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,16,31,0.94) 0%, rgba(0,16,31,0.5) 38%, rgba(0,16,31,0) 66%)"></div>
      <div class="absolute inset-x-0 bottom-0 px-5 pb-6 text-white [text-shadow:0_2px_16px_rgba(0,16,31,0.8)]">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.1em] backdrop-blur [text-shadow:none]">
          <span class="text-gold"><Icon name="star" size={12} /></span> Operators who rank their own businesses
        </p>
        <h1 class="mt-3 font-black leading-[0.95] tracking-[-0.02em]" style="font-size: clamp(38px, 12vw, 56px)">
          Be the first call<br /><span class="text-cyan">in town.</span>
        </h1>
        <p class="mt-3 text-[13px] leading-snug text-white/85 [text-shadow:0_1px_10px_rgba(0,16,31,0.9)]">Joe Ford, founder — 14 years running real businesses, not slide decks.</p>
      </div>
    </div>

    <!-- DESKTOP: full-bleed background -->
    <Image src={joeHero} alt="" class="hidden lg:absolute lg:inset-0 lg:-z-10 lg:block lg:h-full lg:w-full lg:object-cover lg:object-[38%_20%]" loading="eager" />
    <div class="absolute inset-0 -z-10 hidden lg:block" style="background: linear-gradient(100deg, rgba(0,26,55,0.88) 0%, rgba(0,26,55,0.62) 42%, rgba(0,45,94,0.28) 100%)"></div>

    <div class="mx-auto grid max-w-[1320px] gap-8 px-5 pb-14 pt-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-10 lg:py-24">
      <div class="rise text-white lg:[text-shadow:0_2px_18px_rgba(0,16,31,0.55)]">
        <!-- eyebrow + headline: desktop only (mobile has them over the photo) -->
        <p class="hidden items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-[12px] font-semibold uppercase tracking-[0.12em] text-white backdrop-blur lg:inline-flex [text-shadow:none]">
          <span class="text-gold"><Icon name="star" size={13} /></span> Operators who rank their own businesses
        </p>
        <h1 class="hidden font-black leading-[0.95] tracking-[-0.02em] lg:mt-5 lg:block" style="font-size: clamp(44px, 7vw, 88px)">
          Be the first call<br /><span class="text-cyan">in town.</span>
        </h1>
        <p class="max-w-lg text-[18px] leading-relaxed text-white/90 lg:mt-6">
          We make the phone ring for blue collar businesses. A website that books jobs, top-of-Google
          local SEO, and 5-star reviews on autopilot — all handled for you, for less than one lost job a month.
        </p>
        <!-- mobile: Google proof card above the CTA (desktop shows it in the right column) -->
        <div class="mt-6 rounded-[20px] bg-paper p-5 text-left shadow-xl shadow-navy-deep/40 lg:hidden">
          <div class="flex items-center gap-2 border-b border-line pb-3 text-sm text-mute">
            <Icon name="search" size={15} class="text-cyan" /> pool service boca raton
          </div>
          <div class="mt-3 rounded-xl border border-line bg-mist p-4">
            <span class="rounded-full bg-cyan/15 px-2 py-0.5 text-xs font-bold text-cyan-deep">#1 · Map pack</span>
            <p class="mt-2 font-bold text-navy">Florida's Best Pools</p>
            <p class="text-sm text-gold-deep">★★★★★ <span class="text-mute">5.0 · 200 Google reviews</span></p>
            <p class="mt-1 text-sm text-mute">Pool service · Boca Raton, FL · Open 24 hrs</p>
          </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3.5 text-[16px] font-bold text-navy transition hover:bg-white [text-shadow:none]" style="box-shadow: 0 14px 28px rgba(0,0,0,0.3)">
            Claim your free game plan <Icon name="arrow" size={17} />
          </a>
          <a href="#included" class="inline-flex items-center rounded-full border border-white/40 px-7 py-3.5 text-[16px] font-semibold text-white transition hover:bg-white/10 [text-shadow:none]">
            See what you get
          </a>
        </div>
        <p class="mt-4 hidden text-sm text-white/80 lg:block">Joe Ford, founder — 14 years running real businesses, not slide decks.</p>
      </div>

      <!-- Right column: Google proof card + "what we can do for you" site preview -->
      <div class="rise space-y-4 [animation-delay:0.15s]">
        <div class="hidden rounded-[20px] bg-paper p-5 shadow-2xl shadow-navy-deep/50 lg:block">
          <div class="flex items-center gap-2 border-b border-line pb-3 text-sm text-mute">
            <Icon name="search" size={15} class="text-cyan" /> pool service boca raton
          </div>
          <div class="mt-3 rounded-xl border border-line bg-mist p-4">
            <span class="rounded-full bg-cyan/15 px-2 py-0.5 text-xs font-bold text-cyan-deep">#1 · Map pack</span>
            <p class="mt-2 font-bold text-navy">Florida's Best Pools</p>
            <p class="text-sm text-gold-deep">★★★★★ <span class="text-mute">5.0 · 200 Google reviews</span></p>
            <p class="mt-1 text-sm text-mute">Pool service · Boca Raton, FL · Open 24 hrs</p>
          </div>
        </div>

        <a href="https://floridasbestpools.com" target="_blank" rel="noopener" class="block overflow-hidden rounded-[20px] bg-paper shadow-2xl shadow-navy-deep/50">
          <div class="flex items-center gap-1.5 border-b border-line bg-mist px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-red-400"></span>
            <span class="size-2.5 rounded-full bg-yellow-400"></span>
            <span class="size-2.5 rounded-full bg-green-400"></span>
            <span class="ml-2 truncate text-xs text-mute">floridasbestpools.com</span>
          </div>
          <Image src={fbpSite} alt="A website Goliath built and ranks — Florida's Best Pools homepage" class="w-full" loading="lazy" />
          <div class="flex items-center justify-between gap-2 px-4 py-3">
            <p class="text-xs font-semibold text-navy">What we can do for you — a real site we built &amp; rank.</p>
            <span class="inline-flex shrink-0 items-center gap-1 text-xs font-bold text-cyan-deep">See it live <Icon name="arrow" size={13} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- trust strip -->
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-[1320px] px-5 py-8">
      <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        {[['200', '5-star reviews'], ['60+', 'organic calls / mo'], ['#1', 'on Google, local'], ['30+', 'web-form leads / mo']].map(([n, l]) => (
          <div>
            <div class="font-black tracking-[-0.02em] text-navy" style="font-size: clamp(26px, 4vw, 40px)">{n}</div>
            <div class="mx-auto mt-2 h-0.5 w-12 rounded bg-cyan"></div>
            <div class="mt-2 text-[11px] uppercase tracking-[0.16em] text-mute">{l}</div>
          </div>
        ))}
      </div>
      <p class="mt-5 text-center text-xs text-mute/80">Real numbers from Florida's Best Pools — the South Florida pool company we run and rank.</p>
    </div>
  </section>

  <!-- ===== PAIN ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">The problem isn't your work.</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
        You're the best in town.<br />Google doesn't know it yet.
      </h2>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        {[
          ['search', 'The worse guy is winning', "Somewhere in your town, a competitor with sloppier work and a better Google profile is booking the jobs that should be yours. Ranking isn't luck and it isn't seniority. It's a system — and he has one."],
          ['phone', 'Every missed call is a paid-for loss', "A homeowner with water on the floor doesn't leave voicemails. They call the next name on the list. If capture and follow-up depend on whoever's near the phone, you're paying to generate leads for your competitors."],
          ['dollar', "Agencies that never swung a hammer", '$5,000 builds. $2,000-a-month retainers. Reports full of "impressions." All from people who\'ve never run a crew, priced a job, or taken the 9pm emergency call. You want a straight price and a phone that rings. Fair.'],
        ].map(([icon, title, body]) => (
          <div class="rounded-[20px] border border-line bg-mist p-7">
            <span class="inline-grid size-14 place-items-center rounded-2xl bg-cyan/10 text-cyan" style="border: 1.5px solid rgba(17,150,204,0.25)"><Icon name={icon} size={26} /></span>
            <h3 class="mt-4 text-[20px] font-black text-navy">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mute">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== WHY GOLIATH EXISTS (operator story) ===== -->
  <section class="bg-navy px-5 py-24 text-white">
    <div class="mx-auto grid max-w-[1320px] gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="order-2 lg:order-1">
        <div class="relative mx-auto max-w-md overflow-hidden rounded-[24px] shadow-2xl shadow-black/40">
          <Image src={joeFord} alt="Joe Ford, founder of Goliath Solutions" class="w-full object-cover" loading="lazy" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-deep/90 to-transparent p-5">
            <p class="text-sm font-bold">Joe Ford</p>
            <p class="text-xs text-white/70">Founder, Goliath Solutions · Partner, Florida's Best Pools</p>
          </div>
        </div>
        <div class="mx-auto mt-6 grid max-w-md grid-cols-3 gap-3 text-center">
          {[['14 yrs', 'operating'], ['#1', 'own co. ranked'], ['200', '5-star reviews']].map(([n, l]) => (
            <div class="rounded-2xl border border-white/15 bg-white/5 p-4">
              <div class="text-[22px] font-black text-gold">{n}</div>
              <div class="mt-1 text-[10px] uppercase tracking-[0.14em] text-white/60">{l}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-gold">★ Why Goliath exists</p>
        <h2 class="mt-3 font-black leading-[1.02] tracking-[-0.01em]" style="font-size: clamp(30px, 4.5vw, 46px)">
          Built by an operator<br />who actually <span class="text-cyan">ran the business.</span>
        </h2>
        <div class="mt-6 space-y-4 text-[16px] leading-relaxed text-white/80">
          <p>
            Before Goliath, Joe Ford spent 14 years running real companies — hiring crews, chasing invoices,
            answering the phone at dinner. He's a partner in <span class="font-semibold text-white">Florida's Best Pools</span>,
            a 40-year family pool operation in South Florida, and he watched good operators all around him pay
            $2,000 a month for jargon reports that never made the phone ring.
          </p>
          <p>
            So he built the system himself — website, local SEO, Google profile, reviews — for his own company first.
            Today Florida's Best Pools sits at <span class="font-semibold text-white">#1 on Google in its market</span> with
            <span class="font-semibold text-white">200 five-star reviews</span>, pulling
            <span class="font-semibold text-white">60+ organic calls and 30+ web leads a month</span> without buying a single click.
            Then friends in the trades started asking for the same thing. That became Goliath.
          </p>
          <p class="font-semibold text-white">
            When you work with us, you're not getting an account manager. You're getting the operator who's been
            in your seat — running the exact system you're buying, on his own phone, every day.
          </p>
        </div>
        <a href="/about" class="mt-6 inline-flex items-center gap-1.5 font-semibold text-cyan">Read the full story <Icon name="arrow" size={15} /></a>
      </div>
    </div>
  </section>

  <!-- ===== THE OFFER (perk grid) ===== -->
  <section id="included" class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <div class="text-center">
        <p class="text-[11px] font-bold uppercase tracking-[0.22em] text-gold-deep">★ The Goliath Growth System</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
          We don't sell impressions.<br />We sell <span class="text-cyan">booked jobs.</span>
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-mute">No brand engagement. No reach. Seven weapons aimed at the only channels that actually move the phone in local services — built, wired together, and run for you.</p>
      </div>

      <div class="mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {perks.map(([icon, color, title, body, stat, statLabel]) => (
          <div class="group flex h-full flex-col rounded-[20px] border border-line bg-paper p-7 shadow-sm shadow-navy/5 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-navy/10">
            <span class="inline-grid size-14 place-items-center rounded-2xl" style={`color:${color}; background:${color}14; border:1.5px solid ${color}40`}><Icon name={icon} size={28} /></span>
            <h3 class="mt-4 text-[20px] font-black text-navy">{title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{body}</p>
            <div class="mt-5 flex items-end justify-between border-t border-line pt-4">
              <div>
                <div class="text-[26px] font-black" style={`color:${color}`}>{stat}</div>
                <div class="text-[10px] uppercase tracking-[0.18em] text-mute">{statLabel}</div>
              </div>
              <Icon name="arrow" size={20} class="text-line" />
            </div>
          </div>
        ))}
      </div>

      <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-mute">
        Need more firepower? Through vetted partners we also run <span class="font-semibold text-navy">social media marketing</span>, <span class="font-semibold text-navy">video production</span>, and <span class="font-semibold text-navy">Google Ads</span> — added only if your market calls for them. One point of contact either way: us.
      </p>
    </div>
  </section>

  <!-- ===== FLAGSHIP PROOF: FLORIDA'S BEST POOLS ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto grid max-w-[1320px] gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">★ Proof, not promises</p>
        <h2 class="mt-3 font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">We eat our own cooking.</h2>
        <p class="mt-4 leading-relaxed text-mute">
          Every claim on this page runs live on <span class="font-semibold text-navy">Florida's Best Pools</span> — the
          pool company our founder is a partner in. Same website playbook. Same local SEO. Same review engine.
          It owns the map in Boca Raton and Delray Beach, and the phone doesn't stop.
          If it works for our own money, it'll work for yours.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-4">
          {[['#1196cc', '#1', 'on Google for "best florida pools" — up from #7'],
            ['#1196cc', '#2', 'for "pool heater maintenance" — 1,600 searches/mo'],
            ['#1196cc', 'Top 3', 'across Boca Raton & Delray Beach pool searches'],
            ['#a37c08', '★ 5.0', '200 Google reviews and climbing']].map(([color, n, l]) => (
            <div class="rounded-2xl border border-line bg-mist p-5">
              <div class="text-[28px] font-black" style={`color:${color}`}>{n}</div>
              <div class="mt-1 text-sm text-mute">{l}</div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-mute/80">Live Google rankings for floridasbestpools.com, mid-2026.</p>
        <a href="/work" class="mt-5 inline-flex items-center gap-1.5 font-semibold text-cyan-deep">See the full case file <Icon name="arrow" size={15} /></a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={cleanWater} alt="Crystal-clear serviced pool water" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="mt-8 overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={techSkimming} alt="Technician skimming a pool" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={techTesting} alt="Technician testing pool water chemistry" class="h-full w-full object-cover" loading="lazy" /></div>
        <div class="mt-8 overflow-hidden rounded-2xl shadow-lg shadow-navy/10"><Image src={teamMarina} alt="The Florida's Best Pools team" class="h-full w-full object-cover" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- ===== PRICING / VALUE STACK ===== -->
  <section id="pricing" class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <h2 class="text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">No "call for pricing" games.</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-mute">
        Agencies charge $5,000+ to build and $2,000+/month to "manage." We built a leaner system, priced it for a working company, and printed it right here.
      </p>
      <div class="mt-14"><PricingCard /></div>
      <p class="mx-auto mt-8 max-w-xl text-center text-sm text-mute">
        Bigger project — a custom app, an AI agent, automation? We build those too.
        <a href="/contact" class="font-semibold text-cyan-deep">Tell us where it hurts →</a>
      </p>
    </div>
  </section>

  <!-- ===== RISK REVERSAL ===== -->
  <section class="bg-navy px-5 py-16 text-white">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-center">
      <span class="grid size-16 place-items-center rounded-2xl bg-gold/15 text-gold" style="border: 1.5px solid rgba(246,187,6,0.4)"><Icon name="shield" size={32} /></span>
      <h2 class="font-black tracking-[-0.01em]" style="font-size: clamp(28px, 4vw, 40px)">The 90-Day Ring Guarantee</h2>
      <p class="max-w-2xl text-[18px] leading-relaxed text-white/80">
        If your phone isn't ringing with new leads within 90 days of launch, we keep working for free until it does.
        You've carried enough risk for other people's marketing. This time it sits on our side of the table.
      </p>
      <a href={BOOKING_URL} class="mt-2 inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 font-bold text-navy transition hover:bg-white">
        Book your free game plan <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ===== THE METHOD (4 phases) ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">★ The Goliath method</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
        How we make you <span class="text-cyan">the obvious choice</span> in your market.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-mute">Four phases. Real dates. Honest expectations — including the parts other agencies won't say out loud.</p>

      <div class="mt-14 grid gap-5 md:grid-cols-2">
        {phases.map((p) => (
          <div class="flex h-full flex-col rounded-[24px] border border-line bg-mist p-8">
            <div class="flex items-center justify-between">
              <span class="text-[40px] font-black leading-none" style={`color:${p.color}`}>{p.num}</span>
              <span class="rounded-full border border-line bg-paper px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-mute">{p.when}</span>
            </div>
            <h3 class="mt-4 text-[22px] font-black text-navy">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-mute">{p.body}</p>
            <p class="mt-4 border-t border-line pt-4 text-sm font-semibold text-navy">{p.payoff}</p>
          </div>
        ))}
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-mute">
        Meaningful map-pack movement lands <span class="font-semibold text-navy">months 4–6</span> in most markets.
        We'd rather tell you that now than send you a jargon report in month two.
      </p>
    </div>
  </section>

  <!-- ===== COMPARISON (them vs us) ===== -->
  <section class="bg-mist px-5 py-24">
    <div class="mx-auto max-w-[1100px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">★ The comparison</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">
        Most agencies aren't in your corner. <span class="text-cyan">We are.</span>
      </h2>

      <div class="mt-14 grid gap-5 md:grid-cols-2">
        <!-- THEM -->
        <div class="rounded-[24px] border border-line bg-paper p-8">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-mute">✕ Other agencies</p>
          <p class="mt-1 text-sm text-mute">Any business with a credit card.</p>
          <dl class="mt-6 space-y-4">
            {compareRows.map(([label, them]) => (
              <div class="border-b border-line pb-3">
                <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-mute/70">{label}</dt>
                <dd class="mt-1 text-sm text-mute">{them}</dd>
              </div>
            ))}
          </dl>
        </div>
        <!-- US -->
        <div class="rounded-[24px] border-2 border-cyan bg-paper p-8 shadow-lg shadow-cyan/10">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-cyan-deep">✦ Goliath Solutions</p>
          <p class="mt-1 text-sm font-medium text-navy">Blue collar service businesses. Zero dilution.</p>
          <dl class="mt-6 space-y-4">
            {compareRows.map(([label, , us]) => (
              <div class="border-b border-line pb-3">
                <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-mute/70">{label}</dt>
                <dd class="mt-1 flex items-start gap-2 text-sm font-semibold text-navy">
                  <span class="mt-0.5 inline-grid size-4 shrink-0 place-items-center rounded-full bg-cyan text-white"><Icon name="check" size={9} /></span>
                  {us}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-paper px-5 py-24">
    <div class="mx-auto max-w-[1320px]">
      <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-cyan">★ The questions operators actually ask</p>
      <h2 class="mt-3 text-center font-black tracking-[-0.01em] text-navy" style="font-size: clamp(30px, 4.5vw, 44px)">Still skeptical? Good.</h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-mute">The best operators always are. If it's not answered here, ask on the call — you'll get a straight answer.</p>
      <div class="mt-12"><FAQ items={faqItems} /></div>
    </div>
  </section>

  <!-- ===== FINAL CTA (navy band) ===== -->
  <section class="bg-mist px-5 py-24">
    <div class="relative mx-auto max-w-[1100px] overflow-hidden rounded-[32px] p-10 text-center md:p-16" style="background: linear-gradient(135deg, #002d5e 0%, #001a37 100%); box-shadow: 0 40px 80px rgba(0,0,0,0.3)">
      <div class="pointer-events-none absolute -right-20 -top-20 size-80 rounded-full" style="background: rgba(17,150,204,0.18)"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-20 size-80 rounded-full" style="background: rgba(246,187,6,0.1)"></div>
      <div class="relative text-white">
        <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-gold">★ We take a handful of new builds a month ★</p>
        <h2 class="mx-auto mt-3 max-w-2xl font-black tracking-[-0.02em]" style="font-size: clamp(32px, 6vw, 60px)">Stop hoping.<br /><span class="text-cyan">Start booking.</span></h2>
        <p class="mx-auto mt-4 max-w-xl text-[17px] text-white/80">
          A free 30-minute game plan for your market — yours to keep even if we never work together.
          If we're not the right fit, we'll tell you who is. Backed by the 90-Day Ring Guarantee.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={BOOKING_URL} class="inline-flex items-center gap-2 rounded-full bg-gold px-7 py-3.5 text-[16px] font-bold text-navy transition hover:bg-white">Claim your free game plan <Icon name="arrow" size={17} /></a>
          <a href="/contact" class="inline-flex items-center rounded-full border border-white/40 px-7 py-3.5 text-[16px] font-semibold text-white transition hover:bg-white/10">Get a quote</a>
        </div>
        <p class="mt-5 text-xs text-white/50">Free game plan · Zero obligation · 30 minutes</p>
      </div>
    </div>
  </section>
</Layout>
